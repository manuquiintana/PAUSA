# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend de datos: "supabase" (por defecto si hay URL) o "demo" (Postgres en el navegador con datos de ejemplo)
VITE_DATA_BACKEND=

# ElevenLabs (solo para `npm run voz:generar`; nunca la uses en el frontend)
ELEVENLABS_API_KEY=
# Opcional: otra voz distinta de la elegida (8gK5gnQBZnJWm1ta8R8X)
ELEVENLABS_VOICE_ID=
