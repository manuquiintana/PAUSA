# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend de datos: "supabase" (por defecto si hay URL) o "demo" (Postgres en el navegador con datos de ejemplo)
VITE_DATA_BACKEND=
